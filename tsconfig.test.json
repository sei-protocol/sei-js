{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["bun"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]

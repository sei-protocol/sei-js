{
	"extends": "../../tsconfig.base.json",
	"include": ["src"],
	"exclude": ["src/**/__tests__", "src/**/*.spec.ts", "src/**/*.test.ts"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	}
}
